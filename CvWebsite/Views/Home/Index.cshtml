@model AboutMe

@{
    ViewData["Title"] = "Hakkımda";
}

<section class="hero-section">
    <div class="row g-0 align-items-stretch">
        <div class="col-md-5 hero-bg d-flex align-items-center justify-content-center py-4">
            <div class="hero-photo-card text-center" style="max-width: 280px;">
                <img src="@(string.IsNullOrWhiteSpace(Model?.PhotoUrl) ? "https://placehold.co/180x180" : Model.PhotoUrl)" alt="@Model?.NameSurname" />
                <h4 class="mt-3 mb-0">@(Model?.NameSurname ?? "Adınızı admin panelinden ekleyin")</h4>
                <div class="name-rule"></div>
                <div class="job-name">@Model?.JobName</div>
                <div class="hero-social mt-3 pt-3 border-top">
                    <a href="https://www.instagram.com/baharecem_1907/" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </a>
                    <a href="https://x.com/ecem4_ecem" target="_blank" rel="noopener" aria-label="X">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
                    </a>
                    <a href="https://www.linkedin.com/in/bahar-ecem-k%C4%B1sayol-51a956335/" target="_blank" rel="noopener" aria-label="LinkedIn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                    </a>
                    <a href="mailto:baharecem4402@gmail.com" aria-label="E-posta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-7 d-flex align-items-center py-4">
            <div class="px-4 px-md-5">
                <h1 class="hero-title">@(Model?.Title ?? "Merhaba")</h1>
                <p class="fs-5">@(Model?.CatchPhrase ?? "Kim olduğum ve ne yaptığım hakkında")</p>
                <div class="my-4">
                    <a asp-controller="Resume" asp-action="Index" class="btn btn-pill btn-brand me-2">Özgeçmiş</a>
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-pill btn-brand-outline">Projeler</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model?.MainMessage))
                {
                    <p>@Model.MainMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model?.Biography))
                {
                    <p>@Model.Biography</p>
                }
                @if (Model == null)
                {
                    <p class="text-muted">Bu alan admin panelindeki Hakkımda kaydından geliyor. Admin panelinden bir kayıt ekleyince burada görünecek.</p>
                }
            </div>
        </div>
    </div>
</section>

<div class="certs-band">
    <div class="container">
        <h2 class="section-heading justify-content-center"><span class="brand-dot"></span> Sertifikalar</h2>

        @{
            var certificates = ViewBag.Certificates as List<Certificate>;
        }

        @if (certificates == null || !certificates.Any())
        {
            <p class="text-center text-muted">Henüz sertifika eklenmedi. Admin panelinden ekleyebilirsin.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var cert in certificates)
                {
                    <div class="col-6 col-md-3">
                        <div class="certificate-card h-100">
                            <img class="certificate-photo" src="@(string.IsNullOrWhiteSpace(cert.PhotoUrl) ? "https://placehold.co/300x400" : cert.PhotoUrl)" alt="@cert.Title" />
                            <div class="certificate-body">
                                <h6 class="mb-1">@cert.Title</h6>
                                <p class="text-muted mb-0 certificate-desc">@cert.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
