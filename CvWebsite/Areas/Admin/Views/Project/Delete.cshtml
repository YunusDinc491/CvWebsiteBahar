@model Project

@{
    ViewData["Title"] = "Projeyi Sil";
}

<h1>Bu projeyi silmek istediğinize emin misiniz?</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ProjectName)</dt>
    <dd class="col-sm-9">@Model.ProjectName</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.RoleTitle)</dt>
    <dd class="col-sm-9">@Model.RoleTitle</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
