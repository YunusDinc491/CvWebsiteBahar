@model Project

@{
    ViewData["Title"] = "Yeni Proje";
}

<h1>Yeni Proje</h1>

<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="ProjectName" class="form-label"></label>
        <input asp-for="ProjectName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="RoleTitle" class="form-label"></label>
        <input asp-for="RoleTitle" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="MainExplanation" class="form-label"></label>
        <textarea asp-for="MainExplanation" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Explanation" class="form-label"></label>
        <textarea asp-for="Explanation" class="form-control" rows="4"></textarea>
    </div>
    <div class="mb-3">
        <label for="photoFile" class="form-label">Proje Fotoğrafı</label>
        <input type="file" id="photoFile" name="photoFile" class="form-control" accept="image/png, image/jpeg" />
        <div class="form-text">PNG veya JPG, en fazla 5 MB.</div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
