@model IEnumerable<Contact>

@{
    ViewData["Title"] = "Gelen Mesajlar";
}

<h1 class="mb-3">Gelen Mesajlar</h1>

<table class="table table-striped bg-white">
    <thead>
        <tr>
            <th>Gönderen</th>
            <th>Email</th>
            <th>Konu</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.Email</td>
            <td>@item.Subject</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Oku</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Henüz gelen mesaj yok.</p>
}
