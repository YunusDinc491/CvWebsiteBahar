@model IEnumerable<AboutMe>

@{
    ViewData["Title"] = "Hakkımda";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Hakkımda</h1>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kayıt</a>
</div>

<table class="table table-striped bg-white">
    <thead>
        <tr>
            <th>Title</th>
            <th>NameSurname</th>
            <th>JobName</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            <td>@item.NameSurname</td>
            <td>@item.JobName</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
            </td>
        </tr>
}
    </tbody>
</table>
